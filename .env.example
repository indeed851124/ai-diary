# ── 데이터베이스 (Supabase PostgreSQL) ─────────────────────────────
# Supabase 대시보드 > Connect 버튼 > "Connection String"에서 복사한다.
# [YOUR-PASSWORD]는 DB 비밀번호로 바꾸고, 특수문자가 있으면 URL 인코딩한다 (@ → %40 등).

# 앱이 쓰는 연결: Transaction pooler (포트 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# 마이그레이션(prisma migrate)이 쓰는 연결: Session pooler (포트 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase CA 인증서: Database Settings > SSL Configuration > Download certificate
# 파일 경로(프로젝트 루트 기준)를 넣거나, 배포 환경에서는 PEM 내용을 그대로 넣는다 (줄바꿈은 \n).
DATABASE_SSL_CA="certs/supabase-ca.crt"

# 인스턴스당 최대 커넥션 수 (기본 5, 서버리스 배포는 1~2 권장)
# DATABASE_POOL_MAX=5

# 로컬에서 Supabase 대신 `npx prisma dev`를 쓸 때는 위 값 대신 이렇게 둔다:
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/postgres?sslmode=disable"
# (DIRECT_URL, DATABASE_SSL_CA는 비워 둔다)

# ── 인증 ─────────────────────────────────────────────────────────
# 세션 쿠키 서명 키 (32자 이상 랜덤 문자열, 예: openssl rand -base64 32)
SESSION_SECRET=""

# ── AI ───────────────────────────────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=""

# ── Google 로그인 (선택) ─────────────────────────────────────────
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (웹 애플리케이션)
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/google/callback (배포 주소도 따로 추가)
# 비워 두면 Google 버튼을 눌렀을 때 "지금은 쓸 수 없어요" 안내가 나온다.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 프록시 뒤에서 요청 주소가 실제 주소와 다를 때만 지정한다.
# GOOGLE_REDIRECT_URI="https://example.com/api/auth/google/callback"
